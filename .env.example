# Copy this file to `.env` and fill in real values.
#   cp .env.example .env      (mac/linux)     copy .env.example .env   (windows)
# `.env` is gitignored (never committed) because it holds secrets.
# This `.env.example` is the committed TEMPLATE that documents the shape.

# --- App (Phase 0) ---
ENVIRONMENT=local

# --- Supabase (added Phase 2) — the shared database ---
# SUPABASE_URL=https://csrabzuhxbschkeyohha.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=      # server-side only; FREE from Supabase dashboard → Settings → API
# SUPABASE_JWT_SECRET=              # to verify the app user's login (Phase 5)

# --- LLM (added Phase 3) — Groq, OpenAI-compatible ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=                      # FREE tier at groq.com
# LLM_MODEL=llama-3.1-8b-instant    # or a Qwen model — we benchmark (Phase 8)

# --- Embeddings (added Phase 2) ---
# EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Guardrails (added Phase 4) ---
# RATE_LIMIT_PER_DAY=20
# DAILY_SPEND_CAP_USD=5

# --- WhatsApp / MSG91 (added Phase 6, needed only when the number is live) ---
